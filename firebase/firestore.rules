rules_version = '2';

// ---------------------------------------------------------------------------
// SAHAAYA - Cloud Firestore security rules
//
// These rules are the real access control for a patient's medical information.
// The app's UI decides what is *shown*; only these rules decide what can be
// *read*. Everything here assumes the client is hostile.
//
// Deploy with:  firebase deploy --only firestore:rules
// Model and rationale: docs/FIREBASE.md
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function pairingId(patientId, caregiverId) {
      return patientId + '_' + caregiverId;
    }

    // A caregiver may reach a patient's data only while an ACTIVE pairing
    // document exists. Revoking the pairing revokes the access in the same
    // instant, with no client cooperation required.
    function isActiveCaregiverOf(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/pairings/$(pairingId(patientId, request.auth.uid))) &&
        get(/databases/$(database)/documents/pairings/$(pairingId(patientId, request.auth.uid))).data.status == 'active';
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    // --- users/{uid} -----------------------------------------------------
    // Identity and role. Kept small and separate from clinical data so that a
    // caregiver can resolve a name without that granting access to a diagnosis.

    match /users/{uid} {
      allow read: if isSelf(uid) || isActiveCaregiverOf(uid);

      // The document is created at registration by the account it belongs to.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['patient', 'caregiver'];

      // Role is immutable. Pairings, clinical documents and these very rules
      // all assume the role an account was created with.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;

      // Accounts are never deleted from the client; doing so would orphan
      // pairings that a patient relies on for their alert routing.
      allow delete: if false;
    }

    // --- patients/{uid} --------------------------------------------------
    // Clinical detail. Readable by the patient and by any actively paired
    // caregiver. Writable only by the patient: in Phase 2 nobody edits someone
    // else's medical record.

    match /patients/{uid} {
      allow read: if isSelf(uid) || isActiveCaregiverOf(uid);
      allow create, update: if isSelf(uid) && roleOf(request.auth.uid) == 'patient';
      allow delete: if false;

      // --- emergency contacts -------------------------------------------
      // A caregiver must be able to read these in an emergency; only the
      // patient may change who gets called.
      match /emergencyContacts/{contactId} {
        allow read: if isSelf(uid) || isActiveCaregiverOf(uid);
        allow write: if isSelf(uid);
      }

      // --- reminders ------------------------------------------------------
      // Appointments and health checks. Unlike emergency contacts, BOTH sides
      // write here: a caregiver books the hospital visit, the patient notes a
      // blood-pressure check, and each appears on the other's phone.
      //
      // Access is keyed on the patient id in the path, so a caregiver reaches
      // this list only while an ACTIVE pairing with this patient exists, and
      // the document must name the same patient it is stored under - a write
      // cannot file a reminder about one patient inside another's record.
      match /reminders/{reminderId} {
        allow read: if isSelf(uid) || isActiveCaregiverOf(uid);
        allow create, update: if (isSelf(uid) || isActiveCaregiverOf(uid))
          && request.resource.data.patientId == uid;
        allow delete: if isSelf(uid) || isActiveCaregiverOf(uid);
      }

    }

    // --- caregivers/{uid} ------------------------------------------------

    match /caregivers/{uid} {
      // A patient may see the profile of a caregiver linked to them.
      allow read: if isSelf(uid) ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/pairings/$(pairingId(request.auth.uid, uid))) &&
         get(/databases/$(database)/documents/pairings/$(pairingId(request.auth.uid, uid))).data.status == 'active');
      allow create, update: if isSelf(uid) && roleOf(request.auth.uid) == 'caregiver';
      allow delete: if false;
    }

    // --- pairings/{patientId}_{caregiverId} -------------------------------
    // The consent record, and the document every other rule above consults.

    match /pairings/{id} {
      // Split into get and list on purpose.
      //
      // `list` keeps the strict check: a query must never return a pairing
      // that belongs to two other people.
      //
      // `get` additionally tolerates a document that does not exist. Redeeming
      // a code runs one transaction that reads pairings/{patientId}_{caregiverId}
      // to refuse a duplicate link, and on a first-time pairing that document is
      // absent - which makes `resource` null, so the old single `read` rule
      // dereferenced null, errored, and denied. The caregiver saw
      // "You do not have permission to do that" on every genuine first pairing.
      //
      // Permitting the read of an absent document discloses nothing: there is
      // no data to leak, and access to a patient still depends on an ACTIVE
      // pairing existing, which `create` below only allows against an
      // unredeemed, unexpired code redeemed in the same transaction.
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid
      );

      allow list: if isSignedIn() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.caregiverId == request.auth.uid);

      // Only a caregiver creates a pairing, and only for themselves. The
      // document id is pinned to the two participants so the same pair can
      // never produce two competing records.
      //
      // Possession of a valid code is enforced by the pairingCodes rules
      // below: the client writes both documents in a single transaction, so a
      // pairing cannot be committed unless the matching code update - which
      // requires an unredeemed, unexpired code - is also permitted.
      allow create: if isSignedIn()
        && request.resource.data.caregiverId == request.auth.uid
        && request.resource.data.status == 'active'
        && roleOf(request.auth.uid) == 'caregiver'
        && id == pairingId(request.resource.data.patientId, request.auth.uid);

      // Two permitted transitions, and only two.
      //
      // 1. active -> revoked, by either participant.
      //
      // 2. revoked -> active, by the caregiver already named in the document.
      //    This exists because redeeming a code writes the pairing with
      //    `set()`, and `set()` on a document that already exists is an
      //    *update* in rules terms, not a create. Without this branch a pair
      //    that had ever been unlinked could never link again: the caregiver
      //    entered a perfectly valid code and was told "You do not have
      //    permission to do that", because the write was judged against the
      //    revoke-only rule.
      //
      //    It is not a weakening. Reactivation still demands possession of an
      //    unredeemed, unexpired code, because the same transaction must also
      //    satisfy the pairingCodes update rule below - and the participants
      //    are pinned to the ones already in the document, so this can never
      //    attach a caregiver to a patient who did not issue them a code.
      allow update: if isSignedIn()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caregiverId == resource.data.caregiverId
        && (
          (
            (resource.data.patientId == request.auth.uid ||
             resource.data.caregiverId == request.auth.uid)
            && request.resource.data.status == 'revoked'
          )
          ||
          (
            resource.data.status == 'revoked'
            && request.resource.data.status == 'active'
            && resource.data.caregiverId == request.auth.uid
            && roleOf(request.auth.uid) == 'caregiver'
          )
        );

      allow delete: if false;
    }

    // --- pairingCodes/{code} ----------------------------------------------
    // Short-lived and deliberately awkward. A caregiver must be able to look up
    // a code they were told, but must never be able to enumerate codes.

    match /pairingCodes/{code} {
      // Readable only by exact document id - there is no query surface here,
      // so a caregiver can check the code they were given and nothing else.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.patientId == request.auth.uid;

      // Only a patient issues a code, only for themselves, and only with an
      // expiry inside the allowed window.
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && roleOf(request.auth.uid) == 'patient'
        && request.resource.data.redeemedByCaregiverId == null
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 3600000;

      // A code may only be marked redeemed, by the caregiver redeeming it, and
      // only while it is still valid.
      allow update: if isSignedIn()
        && resource.data.redeemedByCaregiverId == null
        && request.resource.data.redeemedByCaregiverId == request.auth.uid
        && resource.data.expiresAt > request.time.toMillis();

      // The patient can cancel their own outstanding code.
      allow delete: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    // --- events/{eventId} -------------------------------------------------
    // Falls, geofence exits, inactivity, SOS and missed doses.
    //
    // Top-level rather than nested under the patient so a caregiver with
    // several patients gets one timeline from one query.

    match /events/{eventId} {
      allow read: if isSignedIn() &&
        (resource.data.patientId == request.auth.uid ||
         isActiveCaregiverOf(resource.data.patientId));

      // Only the patient's own device raises events about them. A caregiver
      // cannot manufacture a fall on someone else's record.
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'new';

      // The log is append-only apart from status. Nobody may rewrite what
      // happened or when - only record that it was seen or withdrawn.
      allow update: if isSignedIn()
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.type == resource.data.type
        && request.resource.data.occurredAt == resource.data.occurredAt
        && (
          // The patient cancels during the confirmation countdown.
          (resource.data.patientId == request.auth.uid &&
           request.resource.data.status == 'cancelled')
          ||
          // A paired caregiver acknowledges.
          (isActiveCaregiverOf(resource.data.patientId) &&
           request.resource.data.status == 'acknowledged' &&
           request.resource.data.acknowledgedByCaregiverId == request.auth.uid)
        );

      // Never. The record of an emergency is not the patient's to erase, and
      // it is not the caregiver's either.
      allow delete: if false;
    }

    // --- medications/{medicationId} ---------------------------------------

    match /medications/{medicationId} {
      allow read: if isSignedIn() &&
        (resource.data.patientId == request.auth.uid ||
         isActiveCaregiverOf(resource.data.patientId));

      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.patientId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId;

      // Removal is a soft delete (isActive = false) through update, so that
      // existing dose history keeps referring to a medicine that still exists.
      allow delete: if false;
    }

    // --- doses/{doseId} ---------------------------------------------------

    match /doses/{doseId} {
      allow read: if isSignedIn() &&
        (resource.data.patientId == request.auth.uid ||
         isActiveCaregiverOf(resource.data.patientId));

      // Written by the patient's device when a reminder fires, and updated by
      // the patient answering it or by the missed-dose sweep.
      allow create, update: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid;

      allow delete: if false;
    }

    // --- settings/{patientId} ---------------------------------------------
    // Monitoring thresholds and the safe zone. Readable by a paired caregiver
    // so they can see what the phone is actually doing, writable only by the
    // patient whose phone it is.

    match /settings/{patientId} {
      allow read: if isSelf(patientId) || isActiveCaregiverOf(patientId);

      // Live tracking is the one thing on this document the patient may read
      // but never write. Listed once and referenced from both branches below,
      // so the two can never drift apart.
      //
      // Mirrored in Kotlin as SettingsFields.TRACKING_KEYS.
      function trackingKeys() {
        return [
          'trackingActive',
          'trackingSessionId',
          'trackingStartedAt',
          'trackingStartedBy',
          'trackingStoppedAt',
          'trackingStoppedBy'
        ];
      }

      // The safe-zone keys a caregiver may author.
      function safeZoneKeys() {
        return [
          'safeZoneLatitude',
          'safeZoneLongitude',
          'safeZoneRadiusMetres',
          'safeZoneLabel',
          'geofenceEnabled',
          'updatedAt'
        ];
      }

      // The patient owns this document and may write all of it.
      //
      // A caregiver may also create it, restricted to the same safe-zone keys
      // they are allowed to update. This is not a widening for its own sake:
      // `settings/{patientId}` is not written at registration, so for a patient
      // who has never opened Monitoring settings the document does not exist -
      // and the caregiver's very first "Save safe zone" is therefore a create,
      // not an update. Without this branch that first save always failed with
      // "You do not have permission to do that", which is exactly what testing
      // on two devices showed.
      //
      // keys() rather than diff(): there is no prior document to diff against
      // on a create, so the whole incoming document is constrained instead.
      allow create: if request.resource.data.patientId == patientId && (
        // The patient creates their own settings - but not the tracking
        // fields. A patient who could create this document with
        // trackingActive = false would be able to pre-empt tracking by
        // writing the document before their caregiver ever did.
        (
          isSelf(patientId)
          && !request.resource.data.keys().hasAny(trackingKeys())
        )
        ||
        (
          isActiveCaregiverOf(patientId)
          && request.resource.data.keys().hasOnly(
            ['patientId'].concat(safeZoneKeys()).concat(trackingKeys())
          )
        )
      );

      allow update: if request.resource.data.patientId == patientId && (
        // The patient owns everything on this document EXCEPT the tracking
        // fields.
        //
        // This is the rule that makes "only your caregiver can stop tracking"
        // true rather than merely displayed. Hiding the button stops a patient
        // tapping it; this stops a patient with a modified client, a REST call
        // or an interactive console session from writing trackingActive =
        // false. hasAny() is the right test because it rejects the write for
        // touching any one of them, without having to enumerate every other
        // key on the document.
        (
          isSelf(patientId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(trackingKeys())
        )
        ||
        // A caregiver configures the safe zone for a patient they are actively
        // paired with - and nothing else on the document.
        //
        // hasOnly() is what keeps this narrow: the write is rejected if it
        // changes any key outside this list, so a caregiver cannot quietly
        // disable fall detection, stretch an inactivity timeout or turn off
        // medicine reminders. Those are the patient's own settings; only the
        // boundary is the caregiver's to draw.
        //
        // Access still ends the moment the pairing is revoked, because
        // isActiveCaregiverOf() reads the pairing document on every request.
        // A caregiver may draw the boundary and switch tracking on or off -
        // and still nothing else. Fall sensitivity, inactivity timeouts and
        // medicine reminders remain the patient's own.
        (
          isActiveCaregiverOf(patientId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(safeZoneKeys().concat(trackingKeys()))
        )
      );

      allow delete: if false;
    }

    // --- trackingSessions/{sessionId} -------------------------------------
    // One caregiver-requested watch, and the route recorded during it.
    //
    // The authority here is split on purpose, because the two sides contribute
    // different things: the caregiver decides that a session exists, and only
    // the patient's own phone can say where the patient is.

    match /trackingSessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        isActiveCaregiverOf(resource.data.patientId)
      );

      // Opened by an actively paired caregiver, naming themselves. A caregiver
      // cannot open a session on a patient they are not linked to, and cannot
      // attribute one to a different caregiver.
      allow create: if isSignedIn()
        && request.resource.data.caregiverId == request.auth.uid
        && isActiveCaregiverOf(request.resource.data.patientId)
        && request.resource.data.active == true;

      // Closed by the caregiver who opened it. The participants and the start
      // time are immutable, so a session cannot be quietly re-attributed or
      // back-dated after the fact.
      allow update: if isSignedIn()
        && resource.data.caregiverId == request.auth.uid
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.caregiverId == resource.data.caregiverId
        && request.resource.data.startedAt == resource.data.startedAt;

      // A route is a record of where somebody went. Neither side gets to erase
      // it, for the same reason the event log cannot be erased.
      allow delete: if false;

      // --- the route ------------------------------------------------------
      match /locations/{locationId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/trackingSessions/$(sessionId))
            .data.patientId == request.auth.uid ||
          isActiveCaregiverOf(
            get(/databases/$(database)/documents/trackingSessions/$(sessionId))
              .data.patientId
          )
        );

        // Only the patient's own device files points, and only into a session
        // that is still open. The `active` check is what stops a stopped
        // session from continuing to accumulate a trail: when the caregiver
        // stops tracking, further writes are refused by the rules and not
        // merely by the client having been asked to stop.
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/trackingSessions/$(sessionId))
               .data.patientId == request.auth.uid
          && get(/databases/$(database)/documents/trackingSessions/$(sessionId))
               .data.active == true;

        // Append-only. A point, once recorded, is what the phone reported.
        allow update, delete: if false;
      }
    }

    // --- notifications/{notificationId} -----------------------------------
    // Delivery log written by the Cloud Function, so a caregiver can tell the
    // difference between "no alert was sent" and "an alert was sent but my
    // phone never showed it".

    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (resource.data.caregiverId == request.auth.uid ||
         resource.data.patientId == request.auth.uid);

      // Server-side only. The Admin SDK bypasses these rules; no client may
      // forge a delivery record.
      allow write: if false;
    }

    // Anything not matched above is denied. New collections must be added here
    // deliberately rather than inheriting access by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
