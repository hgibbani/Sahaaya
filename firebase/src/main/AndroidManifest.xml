<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      POST_NOTIFICATIONS is declared here rather than in :app because the
      component that needs it lives in this module. Android 13+ also requires a
      runtime grant, which the app requests on first launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <service
            android:name=".messaging.SahaayaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Emergency alerts must never be collapsed into a routine channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sahaaya_emergency" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_sahaaya_notification" />
    </application>
</manifest>
